[layer_names]

3d_physics/layer_1="Player"
3d_physics/layer_6="NPC"
3d_physics/layer_11="Ambient"

[physics]

2d/run_on_separate_thread=true
3d/run_on_separate_thread=true
3d/physics_engine="GodotPhysics3D"
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0

[rendering]

occlusion_culling/bvh_build_quality=1
textures/canvas_textures/default_texture_filter=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
anti_aliasing/screen_space_roughness_limiter/enabled=false
occlusion_culling/use_occlusion_culling=true
vrs/directional_shadow/16_bits=true

[shader_globals]

grass_dark_noise={
"type": "sampler2D",
"value": "::vgjhr"
}
grass_light_noise={
"type": "sampler2D",
"value": "::gjj3c"
}
